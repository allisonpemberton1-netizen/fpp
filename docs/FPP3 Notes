  geom_line() + 
  geom_smooth(method = "lm", se = FALSE) + 
  geom_vline(xintercept = c(1940, 1980), size = 1.5) + 
  labs(title = "Fitting a linear line")
  
boston_lm %>% 
  augment() %>% 
  ggplot(aes(Year, .resid)) + 
  geom_point() + 
  geom_hline(yintercept = 0, size = 1.5) + 
  labs(title = "Residual across trend")
```

